rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /employees/{employeeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                    request.resource.data.keys().hasAll(['employeeId', 'name', 'faceDescriptor']) &&
                    request.resource.data.faceDescriptor is list;
      allow update: if request.auth != null && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'faceDescriptor', 'updatedAt']);
    }

    match /attendance/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
